# OCR Studio — environment configuration
# Copy to `.env` (same folder as the compose file); docker compose reads it
# automatically. All values are optional.

# Host port to serve the app on (container always listens on 8000 internally).
WEB_PORT=8000

# Optional HTTP Basic auth — set BOTH to require a login before any access.
# Recommended when exposing the app beyond your own machine. Leave commented
# out to disable (single-user, no auth).
#OCR_USER=admin
#OCR_PASS=change-me

# OCR runtime profile: cpu (default) or gpu. Usually leave unset.
#OCR_PROFILE=cpu

# Where exported datasets are written. Defaults to ./output_det and
# ./output_rec inside the repo.
#
# Move them out if your checkout lives in a synced folder (OneDrive, Dropbox,
# Google Drive): exports reach several GB and the sync client will upload every
# one of them, burning quota and bandwidth on files you can regenerate.
#
# Set the same paths in config/config.yaml under `paths:` so the desktop app
# and the CLI agree with the container — absolute paths are supported there.
#OUTPUT_DET_DIR=D:/ocrstudio-data/output_det
#OUTPUT_REC_DIR=D:/ocrstudio-data/output_rec
